TELEGRAM_BOT_TOKEN=replace_me
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna
TRANSCRIPTION_MODEL=gpt-transcribe
DATABASE_PATH=data/smilekit.db
RATE_LIMIT_PER_MINUTE=10
MAX_VOICE_SECONDS=180
# Отправка заказов в CRM. Оба пустых значения = функция выключена.
CRM_BASE_URL=
CRM_INTERNAL_TOKEN=
# Внутренний HTTP-слой для CRM (настройки бота + лаборатория, /internal/*).
# Обратное направление к CRM_INTERNAL_TOKEN — отдельный секрет.
BOT_INTERNAL_TOKEN=
# Railway сам подставляет PORT; для локального запуска дефолт ниже подходит.
PORT=8080
# Доп. модели через запятую для выбора в настройках бота (помимо OPENAI_MODEL).
BOT_ALLOWED_MODELS=
# Mini App «Моя программа»: публичный HTTPS-адрес страницы /app этого же
# сервиса. Пусто = приложение и напоминания по курсу выключены.
# Пример: https://smilekit-bot.up.railway.app/app
MINIAPP_URL=
# Телеметрия Control Center («коннектор CRM»): heartbeat, расход LLM,
# бизнес-события. Оба пустых значения = коннектор выключен.
CONTROL_CENTER_URL=
CONTROL_CENTER_TOKEN=
# Резервные копии SQLite (раз в 6 часов) в S3-совместимое хранилище
# (Cloudflare R2 / Railway bucket), ключ smilekit-bot/<дата>.db.gz. Все
# пустые = загрузка выключена, копии только локально в data/backups/.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
